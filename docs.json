{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Skye",
  "colors": {
    "primary": "#5E60CE",
    "light": "#9AA0FF",
    "dark": "#4EA8DE"
  },
  "favicon": {
    "light": "/images/sign-black.svg",
    "dark": "/images/sign-white.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "languages": [
      {
        "language": "en",
        "default": true,
        "pages": [
          {
            "group": "Start",
            "pages": [
              "index",
              "chat",
              "tools",
              "self-host"
            ]
          }
        ]
      },
      {
        "language": "ru",
        "groups": [
          {
            "group": "Начало",
            "pages": [
              "ru/index",
              "ru/chat",
              "ru/tools",
              "ru/self-host"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo-horizontal-black.svg",
    "dark": "/images/logo-horizontal-white.svg",
    "href": "https://skye-bot.com"
  },
  "navbar": {
    "links": [
      {
        "href": "https://skye-bot.com",
        "label": "Site"
      },
      {
        "href": "https://chat.skye-bot.com",
        "label": "Open chat"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open in Telegram",
      "href": "https://t.me/skye_ai_bot"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/evvyraine/skye-next"
    }
  },
  "description": "A calm assistant in Telegram.",
  "appearance": {
    "default": "light"
  },
  "seo": {
    "metatags": {
      "og:site_name": "Skye",
      "canonical": "https://docs.skye-bot.com"
    }
  },
  "fonts": {
    "heading": {
      "family": "Lexend"
    },
    "body": {
      "family": "Geist"
    }
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/chat",
      "permanent": true
    }
  ],
  "icons": {
    "library": "tabler"
  },
  "background": {
    "decoration": "grid"
  }
}
